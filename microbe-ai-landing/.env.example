# TOBio frontend environment variables (Vite). Put real values in a .env file (never commit .env).
# ⚠️ Only values that are exposed to the frontend go here. Never put secret keys such as service_role.

# Backend (recommendation/spraying): leave empty to use the production Render URL
VITE_API_BASE_URL=https://microbe-recommend-website.onrender.com

# Kakao address search REST key (domain restriction required in the Kakao console)
VITE_KAKAO_REST_KEY=

# Supabase (login/records). Fill in after creating a new project.
# - URL: project URL (https://xxxx.supabase.co)
# - PUBLISHABLE_KEY: publishable (anon) key. sb_publishable_... or the older anon JWT.
#   ⚠️ Never put the service_role key here.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
